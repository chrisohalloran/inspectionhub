{
  "name": "inspectionhub",
  "container": {
    "build": {
      "dockerfile": "Dockerfile",
      "context": ".."
    },
    "agentCanUpdateSnapshot": false
  },
  "install": "bash .cursor/install.sh",
  "start": "true",
  "terminals": [
    {
      "name": "dev",
      "command": "pnpm dev",
      "description": "Turbo dev servers (Next.js web on :3000, worker, Expo mobile)"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
